# Скопируй в .env и заполни.

# 1 = работать на синтетических данных без WHOOP (удобно для первого запуска)
DEMO_MODE=1

# WHOOP: https://developer-dashboard.whoop.com → Create App
# Redirect URL в дашборде должен совпадать с WHOOP_REDIRECT_URI
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/auth/callback

# Куда вернуть пользователя после логина. При npm run dev поставь http://localhost:5173
WEB_URL=http://localhost:8000

# AI-коуч (https://console.anthropic.com). Без ключа коуч работает в упрощённом режиме.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-sonnet-5-5

# Telegram-бот: создай у @BotFather, вставь токен и имя бота (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TZ=Europe/Moscow

# Путь к базе
DB_PATH=./fitproject.db
